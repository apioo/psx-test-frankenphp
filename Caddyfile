{
    auto_https off
}

:8080 {
    root * public
    encode zstd gzip

    # Rewrite all non-file requests to index.php
    try_files {path} /index.php

    # Execute via FrankenPHP worker mode
    frankenphp {
        worker public/index.php
    }

    # Enable standard PHP file execution fallback
    php_server
}
